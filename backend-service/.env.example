# Copy to .env and fill in values.  Do NOT commit .env to git.
#
# GPU Architecture
# ----------------
# ALL heavy model inference (SDXL, Qwen, CLIP, FaceNet, ControlNet)
# runs on the Colab notebook.  Django on Render is CPU-only and
# acts as an API gateway that proxies requests to Colab.
#
# You only need ONE env var for the Colab URL:
#   COLAB_ML_URL is used by the generate/edit REST endpoints.
#   REMOTE_ML_URL is used by the agent; it defaults to COLAB_ML_URL
#   automatically, so you don't need to set it separately.
#
# ----------------------------------------------------------------
# 1. Deploy the Modal app, then copy the printed remote ML URL below.
# ----------------------------------------------------------------
COLAB_ML_URL=https://YOUR-MODAL-SERVICE.modal.run/generate

# ----------------------------------------------------------------
# Optional overrides (leave commented unless you have a local GPU)
# ----------------------------------------------------------------
# USE_LOCAL_ML=False
# LOW_VRAM_MODE=True
# REMOTE_ML_URL=          # leave blank; auto-inherits from COLAB_ML_URL
