%% SmartSketch LangGraph (ForensicAgentState)
%% Route → artist runs for next_step in: generate | edit | inpaint | age
%% (Mermaid may show a single combined edge to `artist` when targets coincide.)
%% Verify → artist on retry; verify → __end__ on end.

---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	analyze(analyze)
	route(route)
	artist(artist)
	verify(verify)
	__end__([<p>__end__</p>]):::last
	__start__ --> analyze;
	analyze --> route;
	artist --> verify;
	route -. &nbsp;age&nbsp; .-> artist;
	verify -. &nbsp;end&nbsp; .-> __end__;
	verify -. &nbsp;retry&nbsp; .-> artist;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
